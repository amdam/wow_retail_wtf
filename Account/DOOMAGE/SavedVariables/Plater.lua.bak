["Author"] = "Terciob",
["Initialization"] = "function (scriptTable)\n    --insert code here\n    \nend\n\n\n",
["Desc"] = "Show a different animation for the cast bar.",
["Name"] = "Cast - Debuff [P]",
["version"] = -1,
["PlaterCore"] = 1,
