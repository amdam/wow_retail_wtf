["Author"] = "Terciob",
["Initialization"] = "function (scriptTable)\n    --insert code here\n    \nend\n\n\n",
["Desc"] = "For unique abilities that are an important part of the fight against a bosses or mini bosse.",
["Name"] = "Cast - Special Ability [P]",
["version"] = -1,
["PlaterCore"] = 1,
["SpellIds"] = {
