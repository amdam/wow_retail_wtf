["url"] = "",
["Icon"] = "132212",
["Enabled"] = true,
["Revision"] = 482,
["semver"] = "",
["Author"] = "Xephunt-These Go To Eleven",
["Desc"] = "",
["Prio"] = 99,
["Name"] = "Target Border Color",
["PlaterCore"] = 1,
["Options"] = {
{
["Type"] = 1,
["Name"] = "Target Border Color",
["Value"] = {
1,
1,
