["Prio"] = 65,
["Time"] = 1753156688,
["PlaterCore"] = 1,
["Desc"] = "If multiple debuffs are on nameplate at the same time, nameplate changes to your specified color.",
["Name"] = "Quazii Debuffs Combo Color",
