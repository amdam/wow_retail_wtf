},
["url"] = "",
["Icon"] = "3065164",
["Enabled"] = true,
["Revision"] = 58,
["semver"] = "",
["Author"] = "Xephyri-Anasterian",
["Desc"] = "Scales down units the game considers less relevant, commonly fodder enemies.",
["Prio"] = 99,
["Name"] = "Minor Units Scaling",
["PlaterCore"] = 1,
["Options"] = {
{
